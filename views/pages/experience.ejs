<div class="experience-section px-3 py-3" id="experience">
    <h2 class="text-primary">Experience</h2>
    <ul>
        <% for(exp of experience.slice().reverse()){%>
            <li>
                <div class="d-flex">
                    <h4 class="me-5">
                        <%= exp.company%>
                    </h4>
                    <p><b>( <%= (()=> {
                                const d = new Date(exp.DOJ);
                                return String(d.getMonth()+1).padStart(2,"0") + "/" + d.getFullYear();
                                })()%> - <%= (()=> {
                                    if(!exp.DOL){
                                    return "present"
                                    }
                                    const d = new Date(exp.DOL);
                                    return String(d.getMonth()+1).padStart(2,"0") + "/" + d.getFullYear();
                                    })()%> )</b></p>
                </div>
                <p>
                    <%- exp.description%>
                </p>
            </li>
            <% }%>
    </ul>
</div>