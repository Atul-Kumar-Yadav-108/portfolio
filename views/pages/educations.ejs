<div class="eductions section px-3 py-3" id="education">
    <h1 class="text-primary">Education</h1>
    <ul class="row">
        <% for(edu of education){%>
            <li class="col-md-6">
                <div class="d-flex">
                    <h6 class="me-5">
                        <%= edu.course%>
                    </h6>
                    <h6>
                        ( <%= (()=> {
                            const d = new Date(edu.from);
                            return String(d.getMonth()+1).padStart(2,"0") + "/" + d.getFullYear();
                            })()%> - <%= (()=> {
                                const d = new Date(edu.to);
                                return String(d.getMonth()+1).padStart(2,"0") + "/" + d.getFullYear();
                                })()%>)
                    </h6>
                </div>
                <p>
                    <%= edu.insitute%>
                </p>
                <p>
                    CGPA/Grade : <%= edu.grade%>
                </p>
            </li>
            <% }%>
    </ul>
</div>