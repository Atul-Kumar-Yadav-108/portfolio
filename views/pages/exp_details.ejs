<% layout("./layouts/boilerplate.ejs") %>
    <% block('title', 'Experience Details' ) %>

        <div class="projects-section px-3 py-3 m-3 m-md-5">
            <div class=" text-center">

                <a href="/" class="btn btn-primary px-4 me-2">
                    Go Home
                </a>

                <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                    Go Back
                </a>
                <div class="card-bg mt-5 row">
                    <div class="left image-side col-lg-4 d-flex justify-content-center align-items-center mt-md-0 mt-5">
                        <img src="<%= experience.profile ? " text"
                            : "https://plus.unsplash.com/premium_photo-1739178656557-16b949fea186?q=80&w=1074&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                            %>"
                        alt="" width="250px" height="200px" class="rounded">
                    </div>
                    <div class="right image-side col-lg-8">
                        <div class="card-header border border-top-0 border-start-0 border-end-0 ">
                            <h5>
                                <%= experience.company%>
                            </h5>

                            <p class="teck-stack w-full mb-0 pb-0 ">
                                <span class="bg-warning py-1 text-dark rounded px-5  fw-bold">
                                    <%- experience.designation%>
                                </span>

                            </p>
                        </div>
                        <div class="card-body">
                            <h6>
                                <%- experience.description%>
                            </h6>
                            <% if(experience.location) {%>
                                <p>
                                    <i class="bi bi-pin-map-fill"></i>
                                    <%= experience.location %>
                                </p>
                                <% } %>
                                    <p class="teck-stack w-full">
                                        <b class="bg-warning py-1 text-dark rounded px-5">

                                            (
                                            <%= (()=> {
                                                const d = new Date(experience.DOJ);
                                                return String(d.getMonth()+1).padStart(2," 0") + "/" + d.getFullYear();
                                                })()%> -
                                                <%= (()=> {
                                                    if(!experience.DOL){
                                                    return "present"
                                                    }
                                                    const d = new Date(experience.DOL);
                                                    return String(d.getMonth()+1).padStart(2,"0") + "/" +
                                                    d.getFullYear();
                                                    })()%> )
                                        </b>
                                    </p>
                        </div>
                        <hr>
                        <div class=" d-flex justify-content-center  gap-5 mb-3">
                            <a href="/contact" class="btn button-bg-color">Hire me</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>