<% layout("./layouts/boilerplate.ejs")%>
    <% block('title', 'Home' ) %>

        <div class="mainContent">
            <div class="content pt-0 px-3">
                <div class="position-fixed end-0 p-3" style="bottom: 75px;">
                    <a href="/generate-cv" class="btn btn-primary">Download CV<i class="fa-solid fa-download"></i></a>
                </div>
                <%- include("./introduction.ejs", { position: result.position, introduction : result.introduction }) %>
                    <%- include("./projects.ejs",{projects : result.projects}) %>
