<div class="projects-section px-3 py-3 border border-start-0 border-end-0" id="projects">
    <div class="d-flex justify-content-between align-items-center">
        <h2 class=""><i class="bi bi-cart4 text-secondary text-decoration-underline"></i> Featured Builds <span
                class="badge button-bg-color fs-6">Total Projects : <%- projects.length %> </span></h2>
        <a href="./projects/" class="btn button-bg-color">view all</a>
    </div>

    <div class="d-flex flex-md-col flex-wrap justify-content-around mt-3 row">
        <% for(project of projects.slice(-3).reverse()){%>
            <div class="card-bg col-lg-3 col-md-4 px-2 py-3 rounded mb-3">
                <div class="card-head mb-4">
                    <h5 class="text-center">
                        <%=project.projectName%>
                    </h5>
                </div>
                <hr>
                <div class="card-body text-center">
                    <div class="">
                        <img src="<%= project.profile ? " text"
                            : "https://plus.unsplash.com/premium_photo-1739178656557-16b949fea186?q=80&w=1074&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                            %>"
                        alt="" width="100px" height="100px" class="rounded-circle">
                    </div>
                    <p class="description">
                        <%- project.description.toString().length> 150
                            ? project.description.toString().substring(0, 100) + '...'
                            : project.description.toString() %>
                    </p>
                    <p class="teck-stack w-full">
                    <ul class="d-flex  flex-wrap bg-warning py-1 text-dark rounded ">
                        <%for(tech of project.technologies){%>
                            <li class="me-4">
                                <%=tech%>
                            </li>
                            <%}%>
                    </ul>
                    </p>
                    <div class=" d-flex justify-content-center  gap-5">
                        <a href="/projects/<%= project._id %>" class="btn button-bg-color">View details</a>
                        <%- project.liveUrl ? `<a href="${project.liveUrl}" target="_blank"
                            class="btn button-bg-color">Live
                            run</a>`
                            : "" %>
                    </div>
                </div>
            </div>
            <%}%>
    </div>

</div>