<div class="projects-section px-3 py-3" id="projects">
    <h2 class="text-primary">Projects</h2>
    <ul>
        <% for(project of projects.slice().reverse()){%>
            <li>
                <h4>
                    <%=project.projectName%>
                </h4>
                <p>
                    <%- project.description%>
                </p>
                <ul class="d-flex text-primary">
                    <%for(tech of project.technologies){%>
                        <li class="me-4">
                            <%=tech%>
                        </li>
                        <%}%>
                </ul>
            </li>

            <%}%>
    </ul>
</div>