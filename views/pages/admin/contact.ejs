<% block('title', 'Contact' ) %>
    <div class="admin-login-content col-md-6 offset-md-3 text-light pt-5">
        <div class="login-form pt-5 pb-5 dark-grey m-3 px-4 rounded-3">
            <h2 class="text-center mb-5 text-primary">Contact
            </h2>
            <form action="/atul-admin/contact/<%= data._id %>?_method=PUT" method="post">
                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <input type="text" class="form-control" id="name" name="name" placeholder="Enter name"
                        value="<%= data.contact.name%>">

                </div>
                <div class="mb-3">
                    <label for="contact" class="form-label">Contact</label>
                    <input type="text" class="form-control" name="contact" id="contact"
                        placeholder="Enter contact +91 79xxxxxxxx" value="<%= data.contact.contact%>">

                </div>
                <div class=" mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="Email"
                        aria-describedby="emailHelp" value="<%= data.contact.email%>">

                </div>

                <div class=" mb-3">
                    <label for="address" class="form-label">Address</label>
                    <input type="address" class="form-control" id="address" name="address" placeholder="Address"
                        aria-describedby="emailHelp" value="<%= data.contact.address%>">

                </div>
                <div class=" mb-3 text-center">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
    </div>